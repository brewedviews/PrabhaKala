# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017

# MongoDB database name (optional, defaults to "prabha_kala")
DB_NAME=prabha_kala

# Allowed CORS origin(s) for the API (optional, defaults to "*")
CORS_ORIGINS=*

# Shopify Storefront API (headless commerce: products, collections, cart/checkout)
# Store domain (optional, defaults to "prabha-kala.myshopify.com")
SHOPIFY_STORE_DOMAIN=prabha-kala.myshopify.com

# Storefront API PRIVATE access token (required, server-only — never expose to the client).
# Generate under Shopify Admin > Sales channels > Headless > your storefront > API access,
# using the "Private access token" field (not the public one). Sent via the
# Shopify-Storefront-Private-Token header, per lib/shopify/client.js.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version (optional, defaults to "2026-07") — verify this is
# still a supported version at https://shopify.dev/docs/api/usage/versioning
SHOPIFY_STOREFRONT_API_VERSION=2026-07
